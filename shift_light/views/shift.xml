<odoo>
    <record model="ir.ui.view" id="shift_view_tree">
        <field name="name">Shift List</field>
        <field name="model">shift.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="start_time" />
                <field name="end_time" />
                <field name="partner_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="shift_view_form_calendar">
        <field name="name">Shift Form</field>
        <field name="priority">2</field>
        <field name="model">shift.shift</field>
        <field name="arch" type="xml">
            <form class="o_hr_leave_form">
                <header>
                    <field name="state" widget="statusbar" clickable="1" />
                </header>
                <sheet>
                    <group>
                        <field name="start_time" readonly="true"/>
                        <field name="end_time" readonly="true"/>
                        <field name="partner_id" 
                        options="{'no_create': True, 'no_open': True}"
                        domain="[('is_company', '=', False)]"/>
                    </group>
                </sheet>
                <footer>
                    <button 
                    name="action_reserved" 
                    string="Reserve" 
                    type="object" 
                    class="btn-primary"
                    invisible="state == 'reserved'"
                    />
                    <button 
                    name="action_need_help" 
                    string="Need help" 
                    type="object" 
                    class="btn-primary" 
                    invisible="state == 'need_help'"/>
                    <button 
                    name="action_unsubscribe" 
                    string="Unsubcribe" 
                    type="object" 
                    class="btn-default"
                    invisible="state == 'open'"/>
                </footer>
            </form>
        </field>
    </record>

    
    <record model="ir.ui.view" id="shift_view_form">
        <field name="name">Shift Form</field>
        <field name="model">shift.shift</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" clickable="1" />
                    <button 
                    name="action_reserved" 
                    string="Reserve" 
                    type="object" 
                    class="btn-primary"
                    invisible="state == 'reserved'"
                    />
                    <button 
                    name="action_need_help" 
                    string="Need help" 
                    type="object" 
                    class="btn-primary" 
                    invisible="state == 'need_help'"/>
                    <button 
                    name="action_unsubscribe" 
                    string="Unsubcribe" 
                    type="object" 
                    class="btn-default"
                    invisible="state == 'open'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shift_template_id" />
                            <field name="shift_type_id" />
                            <field
                                name="partner_id"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('is_company', '=', False)]"/>
                        </group>
                        <group>
                            <field name="start_time" />
                            <field name="end_time" />
                        </group>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="view_calendar_shift" model="ir.ui.view">
        <field name="name">Shift Calendar</field>
        <field name="model">shift.shift</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <calendar string="Shifts" 
                date_start="start_time" 
                date_stop="end_time" 
                event_open_popup="true"
                quick_create="false"
                color="color"
                form_view_id="%(shift_light.shift_view_form_calendar)d">
                <field name="state" filters="1"/>
                <field  name="partner_id" invisible="1"/>
                <field  name="partner_name" 
                options="{'icon': 'fa fa-user-o'}"
                invisible="not partner_id"
                />
                <field name="partner_phone" 
                options="{'icon': 'fa fa-phone'}" 
                invisible="not partner_id"/>
            </calendar>
        </field>
    </record>

    

    <!-- Actions -->
    <record model="ir.actions.act_window" id="action_shift">
        <field name="name">Shifts</field>
        <field name="res_model">shift.shift</field>
        <field name="view_mode">calendar,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_shift_list">
        <field name="name">Shifts list</field>
        <field name="res_model">shift.shift</field>
        <field name="view_mode">tree,calendar,form,pivot</field>
    </record>

</odoo>
